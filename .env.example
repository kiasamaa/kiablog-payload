# ===== 数据库 =====
# Payload SQLite 适配器的连接地址，默认为项目根目录下的 kiasite.db
DATABASE_URL=file:./kiasite.db

# ===== 安全 =====
# 用于签名 JWT，请替换为足够长的随机字符串
# 生成方式：openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ===== 站点 =====
# 公开访问地址，用于 CORS、绝对链接与 SEO，不要以 / 结尾
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===== 可选 =====
# 定时任务（jobs queue）的访问密钥
CRON_SECRET=YOUR_CRON_SECRET_HERE

# 草稿预览请求的校验密钥
PREVIEW_SECRET=YOUR_SECRET_HERE

# ===== 生产部署（本地开发不用填）=====
# 博客域名，供 docker-compose.prod.yml 里的 Caddy 自动签证书使用
# SITE_DOMAIN=example.com
# 同机其他子域（可选），Caddy 可一并接管并签证书；不需要就留空
# EXTRA_DOMAIN=other.example.com
# ===== 生产部署：宿主机端口与目录（可省略，默认值如下）=====
# app 在宿主机上监听的端口（容器内固定 3000）；反代配置里的端口要与此一致
# APP_PORT=3000
# 数据库存放目录，挂载到容器内 /app/data
# DATA_DIR=./data
# 上传图片目录，挂载到容器内 /app/public/media
# MEDIA_HOST_DIR=./media
# 容器内的媒体路径，由 compose 自动设置，通常不用改
# MEDIA_DIR=/app/public/media
# 允许 Next/Image 优化的外部图床域名，逗号分隔（文章外链封面、正文插图会用到）
# IMAGE_HOSTS=img.example.com,cdn.example.net
# 生产环境是否让 Payload 启动时自动同步表结构（compose 里已设为 true）
# 改了集合字段后重启即可生效；删除字段/改类型前务必先备份数据库
# PAYLOAD_DB_PUSH=true
