# ===== 数据库 =====
# Payload SQLite 适配器的连接地址，默认为项目根目录下的 kiasite.db
DATABASE_URL=file:./kiasite.db

# ===== 安全 =====
# 用于签名 JWT，请替换为足够长的随机字符串
# 生成方式：openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ===== 站点 =====
# 公开访问地址，用于 CORS、绝对链接与 SEO，不要以 / 结尾
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===== 可选 =====
# 定时任务（jobs queue）的访问密钥
CRON_SECRET=YOUR_CRON_SECRET_HERE

# 草稿预览请求的校验密钥
PREVIEW_SECRET=YOUR_SECRET_HERE
