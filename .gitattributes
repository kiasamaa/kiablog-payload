# 部署相关的脚本与配置在 Linux 上执行，必须保持 LF，
# 否则会出现 `bash: /usr/bin/env: 'bash\r': No such file or directory`
*.sh            text eol=lf
Dockerfile      text eol=lf
docker-compose*.yml text eol=lf
deploy/Caddyfile text eol=lf
deploy/nginx.conf text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
